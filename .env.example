# Copy to .env (local) and fill in. Never commit .env.
# In production, set these in Vercel > Project > Settings > Environment Variables.

# ---- Database (Supabase Postgres, region ap-southeast-1 Singapore) ----
# pooled, port 6543 (Supabase "Transaction pooler"); keep ?pgbouncer=true, no connection_limit (pool size is set in src/lib/db.ts)
DATABASE_URL=
# direct, port 5432 (migrations)
DIRECT_URL=

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server only, secret
SUPABASE_SERVICE_ROLE_KEY=

# ---- LLM ----
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
# verify current model id
LLM_PRIMARY=google:gemini-2.5-flash
# verify current model id
LLM_FALLBACK=openai:gpt-4.1-mini

# ---- Speech providers ----
ELEVENLABS_API_KEY=
# built-in voices work on the free plan (Jessica cgSgspJ2msm6clMCkdW9 is the default);
# library voices (e.g. 8U6QQz51HQvOsmbnTJ3D) need a paid plan, else HTTP 402
ELEVENLABS_VOICE_ID=cgSgspJ2msm6clMCkdW9
ELEVENLABS_TTS_MODEL=eleven_v4
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
# Optional model/voice overrides (defaults in comments; verify ids on deploy, DECISIONS B-13)
# default scribe_v2
ELEVENLABS_STT_MODEL=
# unset by default (only sent when set), e.g. bn
ELEVENLABS_TTS_LANGUAGE_CODE=
# default gpt-transcribe
OPENAI_STT_MODEL=
# default gpt-4o-mini-tts
OPENAI_TTS_MODEL=
# default nova (try shimmer or marin)
OPENAI_TTS_VOICE=

# ---- Security ----
# 32+ random bytes, e.g. openssl rand -base64 32
CALL_TOKEN_SECRET=
# 32 bytes base64, e.g. openssl rand -base64 32
BYOK_ENCRYPTION_KEY=
# random string
IP_HASH_SALT=
# random string for the health check
CRON_SECRET=
# reviewer link ?key=..., sent only in the submission email
REVIEW_KEY=

# ---- Limits ----
MAX_CALL_SECONDS=300
RATE_LIMIT_CALLS_PER_IP_HOUR=30
DAILY_CALL_CAP=300

# ---- Domains (two domains, one Vercel project) ----
# Portal host without protocol, e.g. bytevoice-bangla-portal.vercel.app
# On this host, / redirects to /portal. Comma separated list allowed.
PORTAL_HOST=

# ---- Seed only (never commit real values) ----
REVIEWER_EMAIL=
REVIEWER_PASSWORD=
RECEPTIONIST_EMAIL=
RECEPTIONIST_PASSWORD=

# ---- Optional ----
SENTRY_DSN=

# ---- Local tooling only (not read by the app) ----
# E2E_BASE_URL=http://localhost:3000
# PORT=3000
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=/usr/bin/google-chrome
# CI=1
