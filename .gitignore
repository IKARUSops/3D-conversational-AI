# ---- Secrets (never commit) ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- Node / Next.js ----
node_modules/
.pnpm-store/
.next/
out/
build/
dist/
next-env.d.ts
*.tsbuildinfo
.turbo/
.vercel/
.eslintcache

# ---- Logs / debug ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ---- Testing ----
coverage/
playwright-report/
test-results/
blob-report/
playwright/.cache/

# ---- Prisma / Supabase local ----
prisma/*.db
prisma/*.db-journal
supabase/.branches/
supabase/.temp/

# ---- Sentry ----
.sentryclirc

# ---- Python (Blender helper scripts) ----
__pycache__/
*.py[cod]
.venv/

# ---- Blender working files (keep the exported .glb in public/models) ----
*.blend1
*.blend2

# ---- Local recordings / scratch ----
recordings/
tmp/
*.webm
!public/**/*.webm

# ---- OS / editors ----
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
